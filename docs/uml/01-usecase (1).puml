@startuml
title Қауіпсіз корпоративтік мессенджер - Use Case диаграммасы
left to right direction
skinparam packageStyle rectangle

actor "Қызметкер\n(EMPLOYEE)" as Emp
actor "Бөлім басшысы\n(MANAGER)" as Mgr
actor "Жүйе әкімшісі\n(ADMIN)" as Admin
actor "Аудитор\n(AUDITOR)" as Aud

Mgr --|> Emp
Admin --|> Emp

rectangle "Мессенджер жүйесі" {
  usecase "Тіркелу" as UC1
  usecase "Жүйеге кіру (логин)" as UC2
  usecase "Жеке хабарлама жіберу" as UC3
  usecase "Топтық чатқа хабарлама жіберу" as UC4
  usecase "Топтық чат құру" as UC5
  usecase "RSA кілт жұбын жасау" as UC6
  usecase "Хабарламаны шифрлау (AES+RSA)" as UC7
  usecase "Хабарламаны дешифрлау" as UC8

  usecase "Бөлім чатын құру" as UC9
  usecase "Бөлім мүшелерін қосу / шығару" as UC10
  usecase "Бөлім мүшелерін көру" as UC11

  usecase "Пайдаланушыларды басқару (блоктау)" as UC12
  usecase "Рөлдерді тағайындау (RBAC)" as UC13
  usecase "Бөлімдерді басқару" as UC14

  usecase "Аудит журналын көру (тек оқу)" as UC15
}

Emp --> UC1
Emp --> UC2
Emp --> UC3
Emp --> UC4
Emp --> UC5

Mgr --> UC9
Mgr --> UC10
Mgr --> UC11

Admin --> UC12
Admin --> UC13
Admin --> UC14

Aud --> UC2
Aud --> UC15

UC1 ..> UC6 : <<include>>
UC3 ..> UC7 : <<include>>
UC4 ..> UC7 : <<include>>
UC3 ..> UC8 : <<include>>
UC4 ..> UC8 : <<include>>
UC3 ..> UC2 : <<include>>
UC4 ..> UC2 : <<include>>

note bottom of Aud
  Аудитор әкімшіден бөлек рөл:
  әкімші өз әрекетінің ізін өшіре алмайды.
  Аудитор хабарлама мәтінін көрмейді (шифрланған).
end note
@enduml
