@startuml
title Қауіпсіз корпоративтік мессенджер - ER диаграммасы
hide circle
skinparam linetype ortho

entity "departments" as departments {
  * id : BIGINT <<PK>>
  --
  * name : VARCHAR(100) <<unique>>
}

entity "users" as users {
  * id : BIGINT <<PK>>
  --
  * username : VARCHAR(50) <<unique>>
  * password_hash : VARCHAR(100)
  * public_key : TEXT
  * role : VARCHAR(20)
  * blocked : BOOLEAN
  department_id : BIGINT <<FK>>
  * created_at : TIMESTAMP
}

entity "chats" as chats {
  * id : BIGINT <<PK>>
  --
  * name : VARCHAR(100)
  * type : VARCHAR(15)
  department_id : BIGINT <<FK>>
  * created_at : TIMESTAMP
}

entity "chat_members" as members {
  * id : BIGINT <<PK>>
  --
  * chat_id : BIGINT <<FK>>
  * user_id : BIGINT <<FK>>
  * encrypted_chat_key : BYTEA
  * joined_at : TIMESTAMP
}

entity "messages" as messages {
  * id : BIGINT <<PK>>
  --
  * chat_id : BIGINT <<FK>>
  * sender_id : BIGINT <<FK>>
  * ciphertext : BYTEA
  * iv : BYTEA
  * sent_at : TIMESTAMP
}

entity "audit_logs" as audit {
  * id : BIGINT <<PK>>
  --
  user_id : BIGINT <<FK>>
  * action : VARCHAR(50)
  details : TEXT
  * timestamp : TIMESTAMP
}

departments ||--o{ users
departments ||--o| chats
users ||--o{ members
chats ||--o{ members
chats ||--o{ messages
users ||--o{ messages
users ||--o{ audit
@enduml
