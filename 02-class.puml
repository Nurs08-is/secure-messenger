@startuml
title Қауіпсіз корпоративтік мессенджер - Class диаграммасы
skinparam classAttributeIconSize 0

enum Role {
  USER
  ADMIN
}

class User {
  - id: Long
  - username: String
  - passwordHash: String
  - publicKey: String
  - role: Role
  - createdAt: LocalDateTime
}

class Chat {
  - id: Long
  - name: String
  - isGroup: boolean
  - createdAt: LocalDateTime
}

class ChatMember {
  - id: Long
  - encryptedChatKey: byte[]
  - joinedAt: LocalDateTime
}

class Message {
  - id: Long
  - ciphertext: byte[]
  - iv: byte[]
  - sentAt: LocalDateTime
}

class AuditLog {
  - id: Long
  - action: String
  - details: String
  - timestamp: LocalDateTime
}

class AuthService {
  + register(username, password): User
  + login(username, password): String
  + validateToken(token): User
}

class ChatService {
  + createChat(name, members): Chat
  + sendMessage(chatId, ciphertext, iv): Message
  + getHistory(chatId): List<Message>
}

class AdminService {
  + listUsers(): List<User>
  + changeRole(userId, role): void
  + getAuditLogs(): List<AuditLog>
}

class CryptoService {
  + generateRsaKeyPair(): KeyPair
  + generateAesKey(): SecretKey
  + encryptMessage(text, aesKey): EncryptedData
  + decryptMessage(data, aesKey): String
  + wrapKey(aesKey, publicKey): byte[]
  + unwrapKey(wrapped, privateKey): SecretKey
}

User "1" --> "1" Role
User "1" -- "0..*" ChatMember
Chat "1" -- "1..*" ChatMember
Chat "1" -- "0..*" Message
User "1" -- "0..*" Message : sender
User "1" -- "0..*" AuditLog

AuthService ..> User
ChatService ..> Chat
ChatService ..> Message
AdminService ..> AuditLog
@enduml
